@model NutriAI.Models.ChatViewModel

@{
    ViewBag.Title = "NutriAI - Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="chat-container">
    <div class="sidebar">
        <div class="logo d-flex justify-content-between align-items-center">
            <div>
                <h3><i class="fas fa-seedling"></i> NutriAI</h3>
                <p class="mb-0">Tu nutricionista virtual</p>
            </div>
            <button class="btn btn-outline-danger btn-sm" id="logoutBtn" title="Cerrar sesión">
                <i class="fas fa-sign-out-alt"></i>
            </button>
        </div>

        <button class="new-chat-btn" id="newChatBtn">
            <i class="fas fa-plus"></i> Nueva conversación
        </button>

        <div class="chat-history">
            <h5>Historial de conversaciones</h5>
            <div id="historyList">
                @if (Model.ChatSessions != null && Model.ChatSessions.Any())
                {
                    foreach (var session in Model.ChatSessions)
                    {
                        <div class="history-item" data-session-id="@session.Id">
                            <div class="d-flex justify-content-between">
                                <strong>@session.Title</strong>
                                <span>@session.MessageCount mensajes</span>
                            </div>
                            <small>@session.LastMessageTime</small>
                        </div>
                    }
                }
                else
                {
                    <p>No hay conversaciones previas</p>
                }
            </div>
        </div>
    </div>

    <div class="chat-main">

        <div class="chat-main_in">
            <div class="chat-messages" id="chatMessages">
                <div class="welcome-message text-center" style="padding-top: 30%;">
                    <i class="fas fa-comments fa-3x mb-3" style="color: #2e7d32;"></i>
                    <h4>¡Hola! Soy tu nutricionista IA</h4>
                    <p>Pregúntame sobre alimentación saludable, dietas o nutrientes.</p>
                </div>
            </div>

            <div class="chat-input">
                <div class="input-group">
                    <button class="btn btn-outline-success me-2" type="button" data-bs-toggle="modal" data-bs-target="#userInfoModal">
                        <i class="fas fa-user"></i>
                    </button>
                    <textarea class="form-control message-input" id="messageInput" rows="1" placeholder="Escribe tu pregunta sobre nutrición..."></textarea>
                    <button class="btn send-button ms-2" id="sendButton" onclick="sendMessage()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>

            <div class="modal fade" id="userInfoModal" tabindex="-1" aria-labelledby="userInfoModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content rounded-3 shadow">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title" id="userInfoModalLabel"><i class="fas fa-user"></i> Datos del Usuario</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">

                            @using (Html.BeginForm("GuardarUserInfo", "Chat", FormMethod.Post, new { id = "userInfoForm" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.UserInfo.sexo, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserInfo.sexo, new { @class = "form-control", @type = "text", @placeholder = "Coloca tu sexo" })
                                    @Html.ValidationMessageFor(m => m.UserInfo.sexo, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.UserInfo.Edad, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserInfo.Edad, new { @class = "form-control", @type = "number", @placeholder = "Ej: 25" })
                                    @Html.ValidationMessageFor(m => m.UserInfo.Edad, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.UserInfo.Altura, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserInfo.Altura, new { @class = "form-control", @type = "number", @placeholder = "Ej: 175" })
                                    @Html.ValidationMessageFor(m => m.UserInfo.Altura, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.UserInfo.Peso, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserInfo.Peso, new { @class = "form-control", @type = "number", @placeholder = "Ej: 70" })
                                    @Html.ValidationMessageFor(m => m.UserInfo.Peso, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.UserInfo.PreferenciaAlimenticia, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserInfo.PreferenciaAlimenticia, new { @class = "form-control", @placeholder = "Ej: Vegetariano, sin gluten..." })
                                    @Html.ValidationMessageFor(m => m.UserInfo.PreferenciaAlimenticia, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.UserInfo.Objetivo, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.UserInfo.Objetivo, new { @class = "form-control", @placeholder = "Ej: Perder peso, ganar músculo..." })
                                    @Html.ValidationMessageFor(m => m.UserInfo.Objetivo, "", new { @class = "text-danger" })
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success" form="userInfoForm">Guardar</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>


    </div>
</div>
@section Scripts {
    <script>
        let currentSessionId = null;

        // ==============================================
        // 1. HEADERS DE AUTORIZACIÓN
        // ==============================================
        function getAuthHeaders(contentType = 'application/json') {
            const token = localStorage.getItem('jwtToken');
            const headers = { 'Content-Type': contentType };
            if (token) headers['Authorization'] = `Bearer ${token}`;
            return headers;
        }

        // ==============================================
        // 2. MANEJADOR DE RESPUESTAS CON JWT
        // ==============================================
        async function handleAuthResponse(response) {
            if (response.status === 401 || response.status === 403) {
                localStorage.clear(); // limpiar todo localStorage
                window.location.assign('/Account/Login');
                throw new Error("Sesión expirada o inválida.");
            }

            const contentType = response.headers.get('content-type') || '';
            if (!response.ok) {
                const text = await response.text();
                throw new Error(text || `HTTP ${response.status}`);
            }

            if (contentType.includes('application/json'))
                return response.json();
            return {};
        }

        // ==============================================
        // 3. AL CARGAR LA PÁGINA
        // ==============================================
        document.addEventListener("DOMContentLoaded", async () => {
            const token = localStorage.getItem('jwtToken');
            if (!token) {
                localStorage.clear();
                window.location.assign('/Account/Login');
                return;
            }

            currentSessionId = null;
            document.getElementById("chatMessages").innerHTML = '';

            try {
                const res = await fetch('/Chat/GetInitialData', {
                    method: 'GET',
                    headers: getAuthHeaders()
                });
                const data = await handleAuthResponse(res);

                // Asegurarse de asignar la sesión actual correctamente
                if (data.currentSessionId) currentSessionId = data.currentSessionId;

                cargarHistorial(data.chatSessions || []);
                if (data.chatMessages) {
                    data.chatMessages.forEach(m => addMessage(m.isUserMessage ? "Tú" : "NutriAI", m.message));
                }
                if (data.userInfo) cargarUserInfo(data.userInfo);
            } catch (err) {
                console.error("Error init:", err);
                localStorage.clear();
                window.location.assign('/Account/Login');
            }

            // ==========================================
            // Guardar User Info
            // ==========================================
            document.getElementById("userInfoForm")?.addEventListener("submit", async (e) => {
                e.preventDefault();
                const form = e.target;
                const fd = new FormData(form);
                const body = new URLSearchParams();
                body.append("__RequestVerificationToken", fd.get("__RequestVerificationToken"));
                body.append("Sexo", fd.get("UserInfo.Sexo"));
                body.append("Edad", fd.get("UserInfo.Edad"));
                body.append("Altura", fd.get("UserInfo.Altura"));
                body.append("Peso", fd.get("UserInfo.Peso"));
                body.append("PreferenciaAlimenticia", fd.get("UserInfo.PreferenciaAlimenticia"));
                body.append("Objetivo", fd.get("UserInfo.Objetivo"));

                try {
                    const res = await fetch("/Chat/GuardarUserInfo", {
                        method: "POST",
                        headers: getAuthHeaders("application/x-www-form-urlencoded"),
                        body
                    });
                    const data = await handleAuthResponse(res);
                    const modal = bootstrap.Modal.getInstance(document.getElementById("userInfoModal"));
                    if (modal) modal.hide();
                    addMessage("NutriAI", data.mensaje || "Datos guardados.");
                } catch (err) {
                    console.error(err);
                    addMessage("NutriAI", "Error al guardar los datos del usuario.");
                }
            });

            // ==========================================
            // Enviar mensaje
            // ==========================================
            window.sendMessage = async function () {
                const input = document.getElementById("messageInput");
                const message = input.value.trim();
                if (!message) return;

                if (!currentSessionId) {
                    alert("Selecciona o crea un chat antes de enviar un mensaje.");
                    return;
                }

                addMessage("Tú", message);
                input.value = "";
                showTypingIndicator();

                try {
                    const res = await fetch("/Chat/EnviarMensaje", {
                        method: "POST",
                        headers: getAuthHeaders("application/x-www-form-urlencoded"),
                        body: new URLSearchParams({ sessionId: currentSessionId, mensaje: message })
                    });
                    const data = await handleAuthResponse(res);
                    hideTypingIndicator();
                    addMessage("NutriAI", data.respuesta || "Sin respuesta del servidor.");
                    await cargarMensajes(currentSessionId);
                } catch (err) {
                    hideTypingIndicator();
                    addMessage("NutriAI", "Error al enviar mensaje.");
                    console.error(err);
                }
            };

            // ==========================================
            // Nuevo chat
            // ==========================================
            document.getElementById("newChatBtn")?.addEventListener("click", async () => {
                try {
                    const res = await fetch("/Chat/NuevaSesion", {
                        method: "POST",
                        headers: getAuthHeaders()
                    });
                    const data = await handleAuthResponse(res);
                    if (data.success) {
                        currentSessionId = data.sessionId;
                        await recargarHistorial();
                        document.getElementById("chatMessages").innerHTML =
                            '<div class="welcome-message">Nueva conversación iniciada.</div>';
                    }
                } catch (err) {
                    console.error(err);
                    alert("Error al crear nueva sesión.");
                }
            });

            // ==========================================
            // Historial (click o borrar)
            // ==========================================
            document.getElementById("historyList")?.addEventListener("click", async (e) => {
                const del = e.target.closest(".delete-chat");
                if (del) {
                    const id = del.dataset.id;
                    if (!confirm("¿Eliminar esta conversación?")) return;
                    const res = await fetch(`/Chat/BorrarSesion/${id}`, {
                        method: "DELETE",
                        headers: getAuthHeaders()
                    });
                    const data = await handleAuthResponse(res);
                    if (data.success) {
                        await recargarHistorial();
                        document.getElementById("chatMessages").innerHTML = "<div class='welcome-message'>Conversación eliminada.</div>";
                    }
                    return;
                }

                const item = e.target.closest(".history-item");
                if (!item) return;
                currentSessionId = item.dataset.sessionId;
                document.querySelectorAll(".history-item").forEach(el => el.classList.remove("active"));
                item.classList.add("active");
                await cargarMensajes(currentSessionId);
            });

            // ==========================================
            // Helpers
            // ==========================================
            async function recargarHistorial() {
                const res = await fetch("/Chat/GetInitialData", { headers: getAuthHeaders() });
                const data = await handleAuthResponse(res);
                cargarHistorial(data.chatSessions || []);
            }

            function cargarHistorial(sessions) {
                const list = document.getElementById("historyList");
                list.innerHTML = "";
                if (!sessions.length) {
                    list.innerHTML = "<p>No hay conversaciones previas</p>";
                    return;
                }
                sessions.forEach(s => {
                    const div = document.createElement("div");
                    div.className = "history-item";
                    div.dataset.sessionId = s.id;
                    div.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>${s.title}</strong>
                            <button class="btn btn-sm btn-outline-danger delete-chat" data-id="${s.id}">&times;</button>
                        </div>
                        <small>${s.lastMessageTime ? new Date(s.lastMessageTime).toLocaleString() : ''}</small>`;
                    list.appendChild(div);
                });
            }

            async function cargarMensajes(id) {
                const res = await fetch(`/Chat/GetMessages?sessionId=${id}`, { headers: getAuthHeaders() });
                const data = await handleAuthResponse(res);
                const cont = document.getElementById("chatMessages");
                cont.innerHTML = "";
                if (!data.messages || !data.messages.length) {
                    cont.innerHTML = '<div class="welcome-message">Sin mensajes aún.</div>';
                    return;
                }
                data.messages.forEach(m => addMessage(m.isUserMessage ? "Tú" : "NutriAI", m.message));
            }

            function addMessage(sender, text) {
                const c = document.getElementById("chatMessages");
                const d = document.createElement("div");
                d.className = sender === "NutriAI" ? "message bot-message mb-2 p-2 rounded" : "message user-message mb-2 p-2 rounded";
                d.innerHTML = `<strong>${sender}:</strong> ${text}`;
                c.appendChild(d);
                c.scrollTop = c.scrollHeight;
            }

            function showTypingIndicator() {
                const c = document.getElementById("chatMessages");
                const t = document.createElement("div");
                t.id = "typingIndicator";
                t.className = "message bot-message mb-2 p-2 rounded";
                t.innerHTML = "<strong>NutriAI:</strong> <em>Escribiendo...</em>";
                c.appendChild(t);
            }

            function hideTypingIndicator() {
                document.getElementById("typingIndicator")?.remove();
            }

            function cargarUserInfo(ui) {
                document.getElementById("UserInfo_sexo").value = ui.sexo ?? '';
                document.getElementById("UserInfo_Edad").value = ui.edad ?? '';
                document.getElementById("UserInfo_Altura").value = ui.altura ?? '';
                document.getElementById("UserInfo_Peso").value = ui.peso ?? '';
                document.getElementById("UserInfo_PreferenciaAlimenticia").value = ui.preferenciaAlimenticia ?? '';
                document.getElementById("UserInfo_Objetivo").value = ui.objetivo ?? '';
            }

            // enter para enviar
            document.getElementById("messageInput")?.addEventListener("keypress", (e) => {
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    window.sendMessage();
                }
            });

            // ==========================================
            // Logout
            // ==========================================
            document.getElementById("logoutBtn")?.addEventListener("click", async () => {
                if (!confirm("¿Cerrar sesión?")) return;

                try {
                    await fetch("/api/Auth/logout", {
                        method: "POST",
                        credentials: "include"
                    });
                } catch (err) {
                    console.warn("Error cerrando sesión:", err);
                } finally {
                    // limpiar todo
                    localStorage.clear();
                    currentSessionId = null;
                    document.getElementById("chatMessages").innerHTML = '';
                    window.location.assign('/Account/Login');
                }
            });

        });
    </script>

}
