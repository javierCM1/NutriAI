@* NutriAI/Views/Account/Login.cshtml *@

@{
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nutri AI - Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/login.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h3><i class="fas fa-seedling"></i> NutriAI</h3>
            <p class="mb-0">Tu nutricionista virtual</p>
        </div>

        <div class="login-body">


            <!-- Contenedor para mensajes -->
            <div id="message-container" class="alert d-none"></div>

            <form id="loginForm">
                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" required placeholder="tu@email.com">
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" required placeholder="••••••••">
                </div>

                <button type="submit" class="btn">Acceder</button>
            </form>

            <div class="form-footer">
                <p>¿No tienes una cuenta? <a href="/Account/Register">Regístrate aquí</a></p>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', async (event) => {
            event.preventDefault(); // Detener el envío tradicional del formulario

            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const messageContainer = document.getElementById('message-container');

            const loginData = { email, password };

            try {
                // 1. Enviar la solicitud POST al endpoint de la API
                const response = await fetch('/api/Auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(loginData)
                });

                const result = await response.json();

                if (response.ok) {
                    // 2. Login Exitoso: Obtener y guardar el token JWT
                    const token = result.token; // Ya verificamos que esta propiedad existe

                    // Guardar el token de forma segura en el almacenamiento local
                    localStorage.setItem('jwtToken', token);

                    // 3. Mostrar un mensaje breve de éxito (opcional)
                    messageContainer.textContent = result.message || 'Acceso exitoso.';
                    messageContainer.className = 'alert alert-success';
                    messageContainer.classList.remove('d-none');

                    // 4. REDIRECCIÓN INMEDIATA
                    // Usamos la propiedad location.assign() para asegurar la navegación
                    window.location.assign('/Chat/Index'); // <-- La redirección debe ser inmediata

                } else {
                    // Manejar errores (ej: 401 Unauthorized)
                    // Mostrar el mensaje de error del servidor (e.g., 'Credenciales inválidas')
                    messageContainer.textContent = result.message || 'Error desconocido al iniciar sesión.';
                    messageContainer.className = 'alert alert-danger';
                    messageContainer.classList.remove('d-none');
                }
            } catch (error) {
                console.error('Error de conexión:', error);
                messageContainer.textContent = 'Error de conexión con el servidor.';
                messageContainer.className = 'alert alert-danger';
                messageContainer.classList.remove('d-none');
            }
        });
    </script>
</body>
</html>