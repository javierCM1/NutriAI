@* NutriAI/Views/Account/Register.cshtml *@
@{
    ViewData["Title"] = "Registro de Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nutri AI - Registrarse</title>
    <link rel="stylesheet" href="/css/register.css" />
</head>
<body>
    <div class="register-container">


        <div class="register-body">


            <h2 class="form-title">Crear Cuenta</h2>

            <div id="message-container" class="alert d-none"></div>

            <form id="registerForm">
                <div class="form-group">
                    <label for="nombre">Nombre</label>
                    <input type="text" id="nombre" required placeholder="Tu nombre completo">
                </div>

                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" required placeholder="tu@email.com">
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" required placeholder="••••••••">
                </div>

                <button type="submit" class="btn">Registrarse</button>
            </form>

            <div class="form-footer">
                <p>¿Ya tienes una cuenta? <a href="/Account/Login">Inicia sesión aquí</a></p>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('registerForm').addEventListener('submit', async (event) => {
            event.preventDefault(); // Detener el envío tradicional

            const nombre = document.getElementById('nombre').value;
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const messageContainer = document.getElementById('message-container');

            const registerData = { nombre, email, password };

            try {
                // 1. Enviar la solicitud POST al endpoint de la API
                const response = await fetch('/api/Auth/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(registerData)
                });

                const result = await response.json();

                if (response.status === 201) {
                    // 2. Registro Exitoso: Redirigir al usuario al login
                    messageContainer.textContent = result.message || 'Registro exitoso. Serás redirigido.';
                    messageContainer.className = 'alert alert-success';
                    messageContainer.classList.remove('d-none');

                    setTimeout(() => {
                        window.location.href = '/Account/Login';
                    }, 1500); // Dar tiempo para leer el mensaje

                } else {
                    // 3. Manejar errores (ej: 409 Conflict)
                    messageContainer.textContent = result.message || 'Error desconocido al registrar.';
                    messageContainer.className = 'alert alert-danger';
                    messageContainer.classList.remove('d-none');
                }
            } catch (error) {
                console.error('Error de conexión:', error);
                messageContainer.textContent = 'Error de conexión con el servidor.';
                messageContainer.className = 'alert alert-danger';
                messageContainer.classList.remove('d-none');
            }
        });
    </script>
</body>
</html>